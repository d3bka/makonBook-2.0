# MakonBook production environment template
# Copy to .env on the server and fill secrets. Never commit the real file.

APP_IMAGE=nazacd/makonbook:latest

# Django
SECRET_KEY=change-me-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=makonbook.uz,www.makonbook.uz
CSRF_TRUSTED_ORIGINS=https://makonbook.uz,https://www.makonbook.uz
SITE_DOMAIN=makonbook.uz
SITE_PROTOCOL=https
SITE_ID=1

# PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=makonbook
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=disable
DB_CONN_MAX_AGE=600
DATABASE_URL=

# Cloudflare R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=makonbook
R2_ENDPOINT_URL=
R2_REGION=auto

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=support@makonbook.uz
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MakonBook Support <support@makonbook.uz>
SERVER_EMAIL=MakonBook Support <support@makonbook.uz>

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=

# Redis / Celery (direct server install; override hosts if Redis is remote)
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CELERY_RESULT_EXPIRES=86400
REGISTRATION_RATE_LIMIT_CACHE_URL=redis://127.0.0.1:6379/3

# Registration rate limiting
REGISTRATION_RATE_LIMIT_ENABLED=True
REGISTRATION_RATE_LIMIT_IP_MAX=20
REGISTRATION_RATE_LIMIT_IP_WINDOW_SECONDS=600
REGISTRATION_RATE_LIMIT_IDENTIFIER_MAX=5
REGISTRATION_RATE_LIMIT_IDENTIFIER_WINDOW_SECONDS=1800

# Classroom join-code rate limiting (school NAT friendly)
CLASSROOM_JOIN_USER_MAX_ATTEMPTS=10
CLASSROOM_JOIN_IP_MAX_ATTEMPTS=100
CLASSROOM_JOIN_RATE_WINDOW_SECONDS=600

# Test Import rate limiting
TEST_IMPORT_RATE_LIMIT_ENABLED=True
TEST_IMPORT_SUBMIT_COOLDOWN_SECONDS=15
TEST_IMPORT_RATE_LIMIT_MAX=6
TEST_IMPORT_RATE_LIMIT_WINDOW_SECONDS=600

# AI / question audit
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
QUESTION_AUDIT_PROVIDER=deepseek
QUESTION_AUDIT_MODEL=deepseek-v4-flash
QUESTION_AUDIT_TIMEOUT_SECONDS=90
QUESTION_AUDIT_BATCH_SIZE=12
QUESTION_AUDIT_MAX_TOKENS=12000
QUESTION_AUDIT_JSON_RETRIES=2
QUESTION_AUDIT_DEEPSEEK_THINKING=0
QUESTION_AUDIT_DEEPSEEK_REASONING_EFFORT=low
TEST_IMPORT_MODEL=gpt-5.6-terra
TEST_IMPORT_AUDIT_MODEL=deepseek-v4-flash
TEST_IMPORT_RUN_AI_AUDIT=1
TEST_IMPORT_TIMEOUT_SECONDS=180

# HTTPS hardening (settings defaults are already secure when DEBUG=False)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SAMESITE=Lax

# -----------------------------------------------------------------------------
# Hollihop → MakonBook integration
# Keep SCHOOL_DATA_PROVIDER=local for dry-run. After verification change it to
# hollihop. Initial import still runs ONLY from the explicit Manager button.
SCHOOL_DATA_PROVIDER=local
HOLLIHOP_ENABLED=true
HOLLIHOP_MODE=users
HOLLIHOP_API_URL=https://YOUR-SUBDOMAIN.t8s.ru/Api/V2
HOLLIHOP_AUTH_KEY=
HOLLIHOP_WEBHOOK_SECRET=
HOLLIHOP_ALLOWED_LEARNING_TYPES=GROUP
HOLLIHOP_ACTIVE_STUDENT_STATUSES=Занимается,Active,Working
HOLLIHOP_INACTIVE_STUDENT_STATUSES=Inactive,Archived,Stopped studying,Не занимается,Архив,Закончил обучение
HOLLIHOP_CLASSROOM_TYPE=sat
HOLLIHOP_FALLBACK_TEACHER_USERNAME=
HOLLIHOP_MANAGER_TYPES=Admin,Administrator,CEO,Chief Executive Officer,Админ,Администратор
HOLLIHOP_MANAGER_EMPLOYEE_IDS=

# API safety / smart reconciliation
HOLLIHOP_SYNC_INTERVAL_MINUTES=5
HOLLIHOP_TEACHER_POLL_MINUTES=5
HOLLIHOP_MANAGER_POLL_MINUTES=15
HOLLIHOP_MEMBERSHIP_SWEEP_MINUTES=360
HOLLIHOP_STUDENT_PROFILE_SWEEP_MINUTES=360
HOLLIHOP_EDUNIT_CATALOG_SWEEP_MINUTES=360
HOLLIHOP_ATTENDANCE_SWEEP_MINUTES=1440
HOLLIHOP_ATTENDANCE_DELTA_DAYS=7
HOLLIHOP_CHECKPOINT_OVERLAP_SECONDS=120
HOLLIHOP_MIN_REQUEST_INTERVAL=0.20
HOLLIHOP_MAX_PAGES=100
HOLLIHOP_MAX_AUTOMATIC_MEMBERSHIP_REMOVALS=500
HOLLIHOP_MAX_AUTOMATIC_MEMBERSHIP_REMOVAL_RATIO=0.35
HOLLIHOP_MEMBERSHIP_REMOVAL_GUARD_MIN_POPULATION=50
HOLLIHOP_WEBHOOK_RATE_LIMIT=120
HOLLIHOP_RECENT_ATTENDANCE_DAYS=30
HOLLIHOP_ATTENDANCE_CHUNK_DAYS=30

# Never synchronize on Django startup. Credential delivery remains independent
# from data sync and should stay off while Eskiz is in test mode.
HOLLIHOP_AUTO_SYNC_ON_START=false
HOLLIHOP_SEND_CREDENTIALS=false
HOLLIHOP_AUTO_SEND_CREDENTIALS=false

# SMS provider. Disabled is safe until a gateway is configured.
# generic_http expects JSON POST {phone, message, sender} with optional Bearer token.
MAKONBOOK_SMS_PROVIDER=disabled
MAKONBOOK_SMS_API_URL=
MAKONBOOK_SMS_API_TOKEN=
MAKONBOOK_SMS_SENDER=MakonBook
MAKONBOOK_SMS_TIMEOUT_SECONDS=15

# Eskiz.uz (used when MAKONBOOK_SMS_PROVIDER=eskiz)
ESKIZ_API_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# 4546 is Eskiz's standard sender; replace it only if your approved nickname differs.
ESKIZ_SENDER=4546
# Optional delivery-status callback URL. Leave empty until a callback endpoint is enabled.
ESKIZ_CALLBACK_URL=
ESKIZ_TOKEN_CACHE_SECONDS=21600

